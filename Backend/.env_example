# Neon DB / PostgreSQL Connection
# Option 1: Direct Neon connection string (Recommended)
DATABASE_URL=postgresql://username:password@ep-example-123456.us-east-2.aws.neon.tech/skillsync_db?sslmode=require

# Option 2: Discrete connection parameters
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=skillsync_db

# Server Config
PORT=3000

# JWT Auth Config
JWT_SECRET="secretjwt"
JWT_EXPIRES_IN=7d